digraph G { graph [rankdir=TB,bgcolor=white,pad="0.25",nodesep=0.45,ranksep=0.6]; node [shape=box,style="rounded,filled",fillcolor="#eff6e8",color="#73a63f",fontname="DejaVu Sans",fontsize=16,margin="0.2,0.15"]; edge [fontname="DejaVu Sans",fontsize=13,color="#497ca5",fontcolor="#193247"]; start [shape=circle,label="",width=.22,style=filled,fillcolor="#193247",color="#193247"]; end [shape=doublecircle,label="",width=.25,style=filled,fillcolor="#193247",color="#193247"];a [label="В наличии\n[Stocks > 0]"]; b [label="Нет в наличии\n[Stocks = 0]"]; pick [shape=diamond,label="",width=.35,height=.35]; start -> pick; pick -> a [label="[первый снимок: Stocks > 0]"]; pick -> b [label="[первый снимок: Stocks = 0]"]; a -> b [label="Новый снимок [Stocks = 0]"]; b -> a [label="Поставка [Stocks > 0]"]; a -> a [label="Новый снимок [Stocks > 0]"]; b -> b [label="Новый снимок [Stocks = 0]"]; a -> end [label="Прекратить отслеживание"]; b -> end [label="Прекратить отслеживание"];}