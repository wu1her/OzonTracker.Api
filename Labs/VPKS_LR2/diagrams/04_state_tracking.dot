digraph G { graph [rankdir=TB,bgcolor=white,pad="0.25",nodesep=0.45,ranksep=0.6]; node [shape=box,style="rounded,filled",fillcolor="#eff6e8",color="#73a63f",fontname="DejaVu Sans",fontsize=16,margin="0.2,0.15"]; edge [fontname="DejaVu Sans",fontsize=13,color="#497ca5",fontcolor="#193247"]; start [shape=circle,label="",width=.22,style=filled,fillcolor="#193247",color="#193247"]; end [shape=doublecircle,label="",width=.25,style=filled,fillcolor="#193247",color="#193247"];a [label="Не отслеживается"]; b [label="Отслеживается\nentry / доступен в личном списке"]; c [label="Отслеживание остановлено\nИстория сохранена"]; start -> a; a -> b [label="Добавить [товар есть в каталоге]"]; b -> b [label="Повторно добавить / ошибка 409"]; b -> c [label="Подтвердить удаление / IsTracked=0"]; c -> b [label="Добавить повторно / IsTracked=1"]; c -> end [label="Завершить рассматриваемый цикл"];}