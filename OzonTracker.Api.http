@OzonTracker.Api_HostAddress = http://localhost:5080

# Protected requests below require a session in this HTTP client.
# Configure email/password variables in your HTTP client environment; do not commit credentials.
POST {{OzonTracker.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{"email":"{{email}}","password":"{{password}}"}

###

GET {{OzonTracker.Api_HostAddress}}/api/products
Accept: application/json

###
GET {{OzonTracker.Api_HostAddress}}/api/catalog
Accept: application/json

### Add a product from the seeded catalog (409 if already tracked)
POST {{OzonTracker.Api_HostAddress}}/api/products
Content-Type: application/json

{"value":"100000007"}

###
GET {{OzonTracker.Api_HostAddress}}/api/products/100000007
Accept: application/json

### Generate demo snapshots for all tracked products
POST {{OzonTracker.Api_HostAddress}}/api/demo/simulate

### Untrack without deleting price history
DELETE {{OzonTracker.Api_HostAddress}}/api/products/100000007


### Favorites and target price
PUT {{OzonTracker.Api_HostAddress}}/api/products/100000001/preferences
Content-Type: application/json

{"isFavorite":true,"targetPrice":4000}

### Demo sale (current account only)
POST {{OzonTracker.Api_HostAddress}}/api/demo/scenario
Content-Type: application/json

{"scenario":"sale","ozonProductId":100000001}

###
GET {{OzonTracker.Api_HostAddress}}/api/notifications
